# Copy to `.env` and edit. Never commit real secrets.

# Application
PROJECT_NAME=Intelligent Business Automation & Management System
DEBUG=false
VERSION=0.1.0

# Security (REQUIRED in production)
SECRET_KEY=change-me-to-a-long-random-string
ENVIRONMENT=development

# Database (for the future persistence milestone)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ibam

# Redis (queues, caching)
REDIS_URL=redis://localhost:6379/0

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000